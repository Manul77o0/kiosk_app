#!/bin/sh
set -eu

export DISPLAY=:0
export MOZ_ENABLE_WAYLAND=0
export MOZ_USE_XINPUT2=1

HOME=$(getent passwd "$(id -u)" | cut -d: -f6)
if [ -z "$HOME" ]; then
    echo "Could not determine kiosk user's home directory" >&2
    exit 1
fi
export HOME

ready=no
for _ in $(seq 1 60); do
    if xinput list --id-only goodix-ts >/dev/null 2>&1 &&
        wget -q -O /dev/null http://127.0.0.1:18088/api/state.json; then
        ready=yes
        break
    fi
    sleep 1
done
if [ "$ready" != yes ]; then
    echo "Xorg touchscreen or local kiosk server did not become ready" >&2
    exit 1
fi

xset s off -dpms
xinput set-prop goodix-ts "Coordinate Transformation Matrix" 0 1 0 -1 0 1 0 0 1

firefox-esr --no-remote --profile "$KIOSK_HOME/firefox-profile" \
    --kiosk http://127.0.0.1:18088/ &
browser_pid=$!
trap 'kill "$browser_pid" 2>/dev/null || true' EXIT HUP INT TERM

window=
for _ in $(seq 1 60); do
    if ! kill -0 "$browser_pid" 2>/dev/null; then
        echo "Firefox exited before its window was ready" >&2
        wait "$browser_pid"
        exit 1
    fi
    window=$(xdotool search --onlyvisible --class '^firefox-esr$' 2>/dev/null | head -n 1)
    [ -n "$window" ] && break
    sleep 1
done

if [ -z "$window" ]; then
    echo "Firefox window did not appear within 60 seconds" >&2
    exit 1
fi

xdotool windowsize "$window" 960 480
xdotool windowmove "$window" 0 0
wait "$browser_pid"
